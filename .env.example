# Copy this file to .env and fill in COPILOT_GITHUB_TOKEN.
# On Windows, run: pwsh scripts\extract-token.ps1
# That script reads the OAuth token from the `copilot` CLI's Credential Manager
# entry and writes COPILOT_GITHUB_TOKEN into .env, not this template.
# Before recreation, verify selected vs running image IDs (docs/operations.md).
# After token/settings changes: docker compose up -d --no-build --pull never --force-recreate proxy
# A container restart alone does not reload Compose's env_file.

# REQUIRED. The GitHub OAuth token (gho_...) used by your `copilot` CLI.
COPILOT_GITHUB_TOKEN=

# Optional overrides — defaults are correct for the standard tenant.
# COPILOT_PROXY_PORT=4141
# COPILOT_API_BASE=https://api.githubcopilot.com
# COPILOT_INTEGRATION_ID=copilot-developer-cli
# COPILOT_EDITOR_VERSION=copilot-cli-relay/0.6.0

# Optional Codex/Responses overrides, shared by CLI and Codex in the ChatGPT app.
# Defaults are the tested relay values; no app-specific override is required.
# COPILOT_CODEX_INTEGRATION_ID=copilot-developer-cli
# COPILOT_CODEX_EDITOR_VERSION=vscode/1.99.0
# COPILOT_CODEX_PLUGIN_VERSION=copilot-chat/0.43.2026033101
# COPILOT_CODEX_USER_AGENT=GitHubCopilotChat/0.43.2026033101
# COPILOT_CODEX_GITHUB_API_VERSION=2026-01-09
# COPILOT_CODEX_SESSION_ID=
# COPILOT_CODEX_MACHINE_ID=

# LOG_LEVEL=info
# LOG_BODIES=0

# Production bounds: decoded bytes, concurrent HTTP requests, and upload seconds.
# Oversized requests receive 413; oversized upstream bodies receive 502.
# COPILOT_MAX_REQUEST_BYTES=16777216
# COPILOT_MAX_RESPONSE_BYTES=33554432
# COPILOT_MAX_CATALOG_BYTES=2097152
# COPILOT_MAX_CATALOG_MODELS=512
# COPILOT_MAX_INFLIGHT=8
# COPILOT_REQUEST_BODY_TIMEOUT=30
# COPILOT_REQUEST_TIMEOUT=900

# Legacy API fallback is OFF. CLI/app use harness-managed /compact instead.
# Explicit native compact API calls still pass through; see docs/compaction.md.
# COPILOT_ENABLE_SYNTHETIC_COMPACTION=0

# Enable optional capabilities only after qualifying this exact model/client.
# This is non-secret JSON. No model fallback or upstream routing changes.
# COPILOT_CODEX_MODEL_OVERRIDES={"qualified-model":{"supports_search_tool":true}}

# Deployment override: select an already validated production image digest.
# RELAY_IMAGE=copilot-cli-relay@sha256:<verified-image-digest>
# Legacy rollback uses process-scoped RELAY_ROLLBACK_IMAGE with
# docker-compose.rollback.yml. See docs/operations.md.
